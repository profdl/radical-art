---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { sectionLabel, withBase } from "~/lib/text";

const all = await getCollection("pages");

// The 10 top-level categories from the legacy homepage
// (legacy/index.html). Other legacy roots — ego, informe, nature, physics,
// things — appear on this site as virtual sub-categories under one of these
// (matched in Sidebar.astro) so the homepage and sidebar share the same
// top-level information architecture.
const sectionsList: { section: string; slug: string; label: string }[] = [
  { section: "concept", slug: "concept", label: "Concept" },
  { section: "Life", slug: "life", label: "Life" },
  { section: "everything", slug: "everything", label: "Everything" },
  { section: "AlgorithmicArt", slug: "algorithmic-art", label: "Algorithm" },
  { section: "anything", slug: "anything", label: "Anything" },
  { section: "kinetics", slug: "kinetics", label: "Mechanics" },
  { section: "something", slug: "something", label: "Something" },
  { section: "process", slug: "process", label: "Process" },
  { section: "destruction", slug: "destruction", label: "Destruction" },
  { section: "nothing", slug: "nothing", label: "Nothing" },
];

const sections = sectionsList.map((s) => ({
  name: s.label,
  slug: s.slug,
  count: all.filter((p) => p.data.section === s.section).length,
  sample: all
    .filter((p) => p.data.section === s.section && p.data.images.length >= 3)
    .sort((a, b) => b.data.images.length - a.data.images.length)[0],
}));
---

<BaseLayout title="Radical Art" hideSidebar>
  <header class="mb-8">
    <h1 class="h-page">Radical Art</h1>
    <p class="mt-2 prose-archive max-w-3xl">
      An analytical anthology of anti-art and meta-art, originally published by the
      <a href="https://iaaa.nl">Institute of Artificial Art Amsterdam</a>,
      department of art history.
    </p>
    <p class="mt-2 prose-archive max-w-3xl">
      This is a republished version of <a href="https://remkoscha.nl/" target="_blank" rel="noreferrer">Remko Scha</a>'s original site at
      <a href="https://radicalart.info" target="_blank" rel="noreferrer">radicalart.info</a>,
      reorganized for the contemporary web using <a href="https://www.anthropic.com/" target="_blank" rel="noreferrer">Anthropic's Claude Code</a>. Republished by
      <a href="https://certainlynot.com" target="_blank" rel="noreferrer">Daniel Lefcourt</a>,
      Professor,
      <a href="https://www.risd.edu/academics/art-computation" target="_blank" rel="noreferrer">Art &amp; Computation</a>,
      <a href="https://www.risd.edu" target="_blank" rel="noreferrer">Rhode Island School of Design</a>.
    </p>
  </header>
  <hr class="rule" />

  <section class="pt-8">
    <ul class="hub-grid">
      {
        sections.map((s) => (
          <li>
            <a href={withBase("/" + s.slug)} class="hub-card">
              <span class="hub-card-frame">
                {s.sample && s.sample.data.images[0] ? (
                  <img
                    src={withBase(s.sample.data.images[0].src)}
                    alt={s.sample.data.images[0].alt || s.name}
                    loading="lazy"
                  />
                ) : (
                  <span class="hub-card-empty" />
                )}
              </span>
              <span class="hub-card-label">{s.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

</BaseLayout>
