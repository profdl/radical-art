---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import ImageGrid from "~/components/ImageGrid.astro";
import Essay from "~/components/Essay.astro";
import Hub from "~/components/Hub.astro";
import QuoteCollection from "~/components/QuoteCollection.astro";
import Score from "~/components/Score.astro";
import { unwrap, sectionLabel } from "~/lib/text";

export async function getStaticPaths() {
  const all = await getCollection("pages");
  const pagesBySlug = new Map(all.map((p) => [p.data.slug, p.data]));

  // For a given page, walk its blocks and yield candidate figure srcs in
  // priority order (own figures first, then recurse into linked children).
  // Returns a list so callers can pick the first src not already used on the
  // current page, avoiding duplicate thumbnails when many hub links resolve
  // to the same downstream image (e.g. Mona Lisa on /destruction).
  function figureSrcs(slug: string, seen = new Set<string>()): string[] {
    if (seen.has(slug)) return [];
    seen.add(slug);
    const data = pagesBySlug.get(slug);
    if (!data) return [];
    const out: string[] = [];
    for (const b of data.blocks) {
      if ((b as any).type === "figure" && (b as any).src) {
        out.push((b as any).src as string);
      }
    }
    const candidateSlugs: string[] = [];
    for (const b of data.blocks) {
      const links = (b as any).links;
      if (Array.isArray(links)) {
        for (const l of links) {
          if (l?.href && typeof l.href === "string" && l.href.startsWith("/") && !l.external) {
            candidateSlugs.push(l.href.replace(/^\//, "").replace(/\/$/, ""));
          }
        }
      }
      if ((b as any).type === "list" && Array.isArray((b as any).items)) {
        for (const it of (b as any).items) {
          for (const l of it.links ?? []) {
            if (l?.href && typeof l.href === "string" && l.href.startsWith("/") && !l.external) {
              candidateSlugs.push(l.href.replace(/^\//, "").replace(/\/$/, ""));
            }
          }
        }
      }
    }
    const prefix = slug + "/";
    for (const k of pagesBySlug.keys()) {
      if (k.startsWith(prefix) && !k.slice(prefix.length).includes("/")) {
        candidateSlugs.push(k);
      }
    }
    for (const cs of candidateSlugs) {
      out.push(...figureSrcs(cs, seen));
    }
    return out;
  }

  return all
    .filter(
      (p) =>
        p.data.slug && p.data.slug !== "index" && p.data.archetype !== "site-home",
    )
    .map((p) => {
      // Find immediate children whose slug starts with this slug + "/".
      const prefix = p.data.slug + "/";
      const parentTitle = (p.data.title || "").trim().toLowerCase();
      const labelFor = (data: any, rest: string): string => {
        const heading = unwrap(data.heading || "").trim();
        const title = (data.title || "").trim();
        // Prefer the page's own heading; fall back to title only if it's
        // distinct from the parent's title (legacy <title> often duplicates
        // the parent section name).
        if (heading) return heading;
        if (title && title.toLowerCase() !== parentTitle) return title;
        return sectionLabel(rest);
      };
      const childLinks: { href: string; label: string }[] = [];
      for (const [slug, data] of pagesBySlug) {
        if (slug === p.data.slug) continue;
        if (!slug.startsWith(prefix)) continue;
        // Only direct children (one path segment deeper).
        const rest = slug.slice(prefix.length);
        if (rest.includes("/")) continue;
        childLinks.push({
          href: "/" + slug,
          label: labelFor(data, rest),
        });
      }
      childLinks.sort((a, b) => a.label.localeCompare(b.label));

      // For hub-style pages, resolve a thumbnail and the destination page's
      // title for every internal link referenced in the page's blocks.
      const linkThumbs: Record<string, string> = {};
      const linkTitles: Record<string, string> = {};
      const isHub =
        p.data.archetype === "link-hub" ||
        p.data.archetype === "hub-with-essay" ||
        p.data.archetype === "leaf-intro";
      if (isHub) {
        const usedThumbs = new Set<string>();
        const collect = (href: string) => {
          if (!href || !href.startsWith("/")) return;
          const targetSlug = href.replace(/^\//, "").replace(/\/$/, "");
          if (!linkThumbs[href]) {
            const candidates = figureSrcs(targetSlug);
            const pick =
              candidates.find((s) => !usedThumbs.has(s)) ?? candidates[0];
            if (pick) {
              linkThumbs[href] = pick;
              usedThumbs.add(pick);
            }
          }
          if (!linkTitles[href]) {
            const target = pagesBySlug.get(targetSlug);
            if (target) {
              const rest = targetSlug.startsWith(prefix)
                ? targetSlug.slice(prefix.length)
                : targetSlug.split("/").pop() || targetSlug;
              linkTitles[href] = labelFor(target, rest);
            }
          }
        };
        for (const b of p.data.blocks) {
          for (const l of (b as any).links ?? []) {
            if (l?.href && !l.external) collect(l.href);
          }
          if ((b as any).type === "list") {
            for (const it of (b as any).items ?? []) {
              for (const l of it.links ?? []) {
                if (l?.href && !l.external) collect(l.href);
              }
            }
          }
        }
        for (const c of childLinks) collect(c.href);
      }

      return {
        params: { slug: p.data.slug },
        props: { page: p.data, childLinks, linkThumbs, linkTitles },
      };
    });
}

const { page, childLinks, linkThumbs, linkTitles } = Astro.props;
const heading = page.heading ? unwrap(page.heading) : page.title;
const description = page.description ? unwrap(page.description) : "";
const sectionSlug = page.section
  .replace(/(?<=[a-z0-9])(?=[A-Z])/g, "-")
  .toLowerCase();

// Strip blocks whose text duplicates the page title (the legacy site often
// repeated the title as the first heading).
const blocks = page.blocks.filter((b: any) => {
  if (b.type !== "heading") return true;
  const t = unwrap(b.text || "").trim().toLowerCase();
  return t !== unwrap(page.title || "").trim().toLowerCase() &&
         t !== heading.trim().toLowerCase();
});
---

<BaseLayout title={page.title} description={description} current={sectionSlug} currentSlug={page.slug}>
  <header class="mb-6">
    <Breadcrumb slug={page.slug} section={page.section} />
    <h1 class="h-page mt-4">{heading}</h1>
    {
      description && (
        <p class="mt-2 prose-archive max-w-3xl text-[color:var(--color-ink-muted)]">
          {description}
        </p>
      )
    }
  </header>
  <hr class="rule" />

  <div class="pt-8">
    {
      page.archetype === "image-grid" || page.archetype === "single-work" ? (
        <ImageGrid blocks={blocks} />
      ) : page.archetype === "essay" || page.archetype === "long-essay" ? (
        <Essay blocks={blocks} />
      ) : page.archetype === "link-hub" ||
        page.archetype === "hub-with-essay" ||
        page.archetype === "leaf-intro" ? (
        <Hub blocks={blocks} pageTitle={heading} childLinks={childLinks} linkThumbs={linkThumbs} linkTitles={linkTitles} />
      ) : page.archetype === "quote-collection" ? (
        <QuoteCollection blocks={blocks} pageTitle={heading} />
      ) : page.archetype === "score" ? (
        <Score blocks={blocks} />
      ) : page.archetype === "bio-credit" ? (
        <Essay blocks={blocks} />
      ) : (
        <div class="prose-archive max-w-2xl">
          <p class="text-[color:var(--color-ink-faint)] italic">
            [{page.archetype} layout not yet implemented.]
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
