---
interface Props {
  current?: string;
}

const { current } = Astro.props;

const items = [
  { label: "Concept", slug: "concept" },
  { label: "Life", slug: "life" },
  { label: "Everything", slug: "everything" },
  { label: "Algorithm", slug: "algorithmic-art" },
  { label: "Anything", slug: "anything" },
  { label: "Mechanics", slug: "kinetics" },
  { label: "Something", slug: "something" },
  { label: "Process", slug: "process" },
  { label: "Destruction", slug: "destruction" },
  { label: "Nothing", slug: "nothing" },
];
---

<aside>
  <nav>
    {
      items.map((it) => {
        const active = current === it.slug;
        return (
          <a
            href={"/" + it.slug}
            class={`sidebar-link ${active ? "underline underline-offset-4" : ""}`}
          >
            {it.label}
          </a>
        );
      })
    }
  </nav>
</aside>
