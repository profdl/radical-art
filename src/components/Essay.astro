---
import Paragraph from "./Paragraph.astro";
import Figure from "./Figure.astro";

interface Block { type: string; [k: string]: any; }
interface Props { blocks: Block[]; }

const { blocks } = Astro.props;

type Item =
  | { kind: "h2"; text: string }
  | { kind: "h3"; text: string }
  | { kind: "h4"; text: string }
  | { kind: "p"; block: Block }
  | { kind: "pre"; text: string }
  | { kind: "ul"; items: { text: string }[] }
  | { kind: "fig"; block: Block };

const items: Item[] = blocks
  .map<Item | null>((b) => {
    if (b.type === "heading") {
      const lvl = (b.level ?? 3) as number;
      if (lvl <= 2) return { kind: "h2", text: b.text };
      if (lvl === 3) return { kind: "h3", text: b.text };
      return { kind: "h4", text: b.text };
    }
    if (b.type === "paragraph") return { kind: "p", block: b };
    if (b.type === "preformatted") return { kind: "pre", text: b.text };
    if (b.type === "list") return { kind: "ul", items: b.items };
    if (b.type === "figure") return { kind: "fig", block: b };
    return null;
  })
  .filter((x): x is Item => x !== null);
---

<article class="prose-archive max-w-[42rem]">
  {
    items.map((it) => {
      if (it.kind === "h2") return <h2>{it.text}</h2>;
      if (it.kind === "h3") return <h3>{it.text}</h3>;
      if (it.kind === "h4") return <h4>{it.text}</h4>;
      if (it.kind === "p")
        return <Paragraph text={it.block.text} links={it.block.links} />;
      if (it.kind === "pre")
        return <pre class="text-[0.9rem] whitespace-pre-wrap">{it.text}</pre>;
      if (it.kind === "ul")
        return (
          <ul class="list-disc pl-6">
            {it.items.map((x) => <li>{x.text}</li>)}
          </ul>
        );
      return (
        <div class="my-8 max-w-[28rem]">
          <Figure block={it.block as any} />
        </div>
      );
    })
  }
</article>
