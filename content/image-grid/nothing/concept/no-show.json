      "height": "235",
      "links": []
    },
    {
      "type": "heading",
      "text": "Robert Barry",
      "links": [],
      "level": 5
    },
    {
      "type": "heading",
      "text": "Closed Gallery Piece, 1969",
      "links": [],
      "level": 6
    },
    {
      "type": "heading",
      "text": "\"During the exhibition the gallery will be closed.\"",
      "links": [],
      "level": 6
    },
