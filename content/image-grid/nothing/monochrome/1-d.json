      "width": "2",
      "height": "140",
      "links": []
    },
    {
      "type": "paragraph",
      "text": "The line above is rotating\n\non its axis at a speed of\n\none revolution each day.",
      "links": []
    },
    {
      "type": "paragraph",
      "text": "Douglas Huebler, 1970",
      "links": []
    },
    {
      "type": "heading",
      "text": "Draw a straight line\n\nand follow it.",
      "links": [],
      "level": 6
    },
    {
      "type": "paragraph",
      "text": "La Monte Young:\n\nComposition 1960 # 10\n\n(to Bob Morris)",
      "links": []
