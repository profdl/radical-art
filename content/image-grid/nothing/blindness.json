    {
      "type": "paragraph",
      "text": "The quotes from Jean Giraudoux and Karel van de Woestijne are discussed by Victor E. van Vriesland in Het werkelijkheidsgehalte in de letterkunde (Amsterdam: Em. Querido's Uitgeverij, 1962), pp. 82/83.",
      "links": [
        {
          "text": "Het werkelijkheidsgehalte in de letterkunde",
          "href": "http://www.dbnl.org/tekst/vrie060werk01_01/vrie060werk01_01_0036.php",
          "external": true
        }
