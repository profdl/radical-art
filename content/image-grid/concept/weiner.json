    {
      "type": "heading",
      "text": "Lawrence Weiner: \"Statements\"",
      "links": [],
      "level": 4
    },
    {
      "type": "heading",
      "text": "(1) The artist may construct the piece.\n\n(2) The piece may be fabricated.\n\n(3) The piece need not be built.\n\n\n\nEach being equal and consistent with the intent of artist, the decision as to condition rests with the receiver upon the occasion of receivership.",
      "links": [],
      "level": 6
    },
    {
      "type": "heading",
      "text": "Lawrence Weiner, 1968.",
      "links": [],
      "level": 6
    },
