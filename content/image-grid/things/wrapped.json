      "type": "heading",
      "text": "Wrappings",
      "links": [],
      "level": 1
    },
    {
      "type": "paragraph",
      "text": "\"If you wrap up different kinds of furniture in enough wrapping paper, you can make them all look the same shape.\"",
      "links": []
    },
    {
      "type": "paragraph",
      "text": "Ludwig Wittgenstein.",
      "links": []
