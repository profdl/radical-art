    {
      "type": "paragraph",
      "text": "This is a republished version of the original site at radicalart.info, reorganized for the contemporary web. Every effort has been made to stay true to the original site's content and intentions.",
      "links": [
        {
          "text": "radicalart.info",
          "href": "https://radicalart.info",
          "external": true
        }
      ]
    },
    {
